# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# "Publishable" key (sb_publishable_...) or legacy "anon" key. Safe in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret" key (sb_secret_...) or legacy "service_role" key. Server only — never commit.
SUPABASE_SECRET_KEY=

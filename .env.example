# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# "Publishable" key (sb_publishable_...) or legacy "anon" key. Safe in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret" key (sb_secret_...) or legacy "service_role" key. Server only — never commit.
SUPABASE_SECRET_KEY=

# Optional: usernames allowed to open the owner page at /owner (comma-separated).
# Create your own account in the app first, then put its username here.
OWNER_USERNAMES=

# Optional: phone notifications for invites (web push).
# Make a key pair once with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional contact for push services (mailto:you@example.com or your site address).
# Defaults to the Vercel site address.
VAPID_SUBJECT=
